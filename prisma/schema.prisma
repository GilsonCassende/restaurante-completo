generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
  DRIVER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELED
}

enum DeliveryOrderStatus {
  RECEIVED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum DriverStatus {
  AVAILABLE
  BUSY
  OFFLINE
  IN_DELIVERY
}

enum DriverShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  MISSED
  CANCELED
}

enum DeliveryZoneType {
  NEIGHBORHOOD
  POSTAL_CODE
  RADIUS
  POLYGON
}

enum DeliveryFeeType {
  FIXED
  DISTANCE
  ZONE
  FREE_SHIPPING
  MINIMUM_ORDER
  PROMOTION
}

enum DispatchMode {
  MANUAL
  AUTOMATIC
}

enum MapProvider {
  GOOGLE_MAPS
  MAPBOX
  OPENSTREETMAP
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum TrackingEventType {
  ORDER_RECEIVED
  PREPARING
  READY
  DRIVER_ASSIGNED
  OUT_FOR_DELIVERY
  LOCATION_UPDATE
  DELIVERED
  CANCELED
  ETA_UPDATED
  DELAYED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELED
}

enum UsageMetric {
  PRODUCTS
  ORDERS
  TABLES
  USERS
  CUSTOMERS
  CAMPAIGNS
  COUPONS
  DRIVERS
  RESERVATIONS
}

enum BillingHistoryStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  VOID
}

enum RestaurantMemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INVITED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  WEBSITE
  WHATSAPP
  PHONE
  ADMIN
  WALK_IN
}

enum ReservationHistoryAction {
  CREATED
  UPDATED
  CANCELLED
  CONFIRMED
  CHECKED_IN
  COMPLETED
}

enum CustomerStatus {
  ACTIVE
  VIP
  INACTIVE
  BLOCKED
}

enum CustomerSegmentType {
  NEW
  RECURRING
  VIP
  INACTIVE
  BIRTHDAY
  HIGH_VALUE
  LOW_VALUE
}

enum LoyaltyRewardType {
  DISCOUNT
  PRODUCT_FREE
  SHIPPING_FREE
  CASHBACK
  GIFT
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  FIRST_PURCHASE
  BIRTHDAY
  SEGMENT
  PERIOD
}

enum CashbackTransactionType {
  CREDIT
  DEBIT
  EXPIRE
  REDEEM
  REFUND
}

enum CampaignChannel {
  WHATSAPP
  EMAIL
  SMS
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum PaymentGatewayProvider {
  STRIPE
  MERCADO_PAGO
  PAYPAL
  PAGAR_ME
  ASAAS
  YOOKASSA
  M_PESA
  UNITEL_MONEY
}

enum PaymentMethodType {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  TRANSFER
  DIGITAL_WALLET
  IN_PERSON
  QR_CODE
  PARTIAL
  SPLIT
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
  OVERDUE
}

enum InstallmentStatus {
  PENDING
  PAID
  CANCELED
  OVERDUE
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
  CANCELED
}

enum PaymentTransactionType {
  AUTHORIZE
  CAPTURE
  SETTLEMENT
  VOID
  REFUND
  CHARGEBACK
  ADJUSTMENT
}

enum FinancialMovementType {
  REVENUE
  EXPENSE
  REFUND
  FEE
  TAX
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum GatewayLogStatus {
  SUCCESS
  FAILED
  RETRYING
  PENDING
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  RETRYING
}

enum WebhookEventType {
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  PAYMENT_PENDING
  CHARGEBACK
  REFUND
  CANCELLATION
}

model Restaurant {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String   @unique
  logo             String?
  favicon          String?
  banner           String?
  coverImage       String?
  primaryColor     String?
  secondaryColor   String?
  accentColor      String?
  backgroundColor  String?
  surfaceColor     String?
  textColor        String?
  successColor     String?
  warningColor     String?
  errorColor       String?
  fontFamily       String?
  borderRadius     String?
  buttonStyle      String?
  cardStyle        String?
  heroStyle        String?
  footerStyle      String?
  instagram        String?
  facebook         String?
  tiktok           String?
  youtube          String?
  linkedin         String?
  website          String?
  phone            String?
  supportPhone     String?
  whatsapp         String?
  email            String?  @unique
  address          String?
  slogan           String?
  history          String?
  mission          String?
  description      String?
  state            String?
  neighborhood     String?
  street           String?
  number           String?
  postalCode       String?
  latitude         Float?
  longitude        Float?
  openingHours     String?
  timezone         String?
  currency         String?
  language         String?
  country          String?
  city             String?
  weeklyHours      Json?
  holidays         Json?
  isOpen           Boolean? @default(true)
  minimumOrderAmount Float?
  deliveryFee      Float?
  deliveryRadiusKm Int?
  averagePreparationTime Int?
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  ogImage          String?
  twitterTitle     String?
  twitterDescription String?
  twitterImage     String?
  integrations     Json?
  subscriptionPlan String   @default("FREE")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  users            User[]
  customers        Customer[]
  customerProfiles CustomerProfile[]
  customerAddresses CustomerAddress[]
  customerPreferences CustomerPreferences[]
  customerSegments CustomerSegment[]
  loyaltyAccounts  LoyaltyAccount[]
  loyaltyTransactions LoyaltyTransaction[]
  coupons          Coupon[]
  couponUsages     CouponUsage[]
  cashbackAccounts CashbackAccount[]
  cashbackTransactions CashbackTransaction[]
  campaigns        Campaign[]
  campaignRecipients CampaignRecipient[]
  paymentMethods   PaymentMethod[]
  payments         Payment[]
  transactions     Transaction[]
  refunds          Refund[]
  invoices         Invoice[]
  installments     Installment[]
  financialMovements FinancialMovement[]
  wallets          Wallet[]
  gatewayLogs      GatewayLog[]
  webhookEvents    WebhookEvent[]
  deliveryAddresses DeliveryAddress[]
  drivers         Driver[]
  driverShifts    DriverShift[]
  deliveryZones   DeliveryZone[]
  deliveryFees    DeliveryFee[]
  dispatches      Dispatch[]
  routes          Route[]
  trackingEvents  TrackingEvent[]
  deliverySettings DeliverySettings?
  organization    Organization?
  subscriptions   Subscription[]
  licenses        License[]
  restaurantMembers RestaurantMember[]
  invitations     Invitation[]
  auditLogs       AuditLog[]
  apiKeys         ApiKey[]
  usages          Usage[]
  billingHistory  BillingHistory[]
  categories       Category[]
  products         Product[]
  tables           Table[]
  orders           Order[]
  reservations     Reservation[]
  reservationHistory ReservationHistory[]

  @@index([active])
}

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String     @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  email        String     @unique
  password     String
  image        String?
  role         Role
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdReservations Reservation[] @relation("ReservationCreatedBy")
  reservationHistory   ReservationHistory[] @relation("ReservationHistoryActor")

  @@index([restaurantId])
  @@index([role])
  @@index([active])
}

model Customer {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String       @db.ObjectId
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  birthday     DateTime?
  city         String?
  country      String?
  status       CustomerStatus @default(ACTIVE)
  tags         Json?
  lastVisitAt  DateTime?
  totalSpent   Float         @default(0)
  averageTicket Float         @default(0)
  frequency    Int           @default(0)
  notes        String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reservations Reservation[]
  profile      CustomerProfile?
  addresses    CustomerAddress[]
  preferences  CustomerPreferences?
  loyaltyAccount LoyaltyAccount?
  cashbackAccount CashbackAccount?
  loyaltyTransactions LoyaltyTransaction[]
  couponUsages CouponUsage[]
  cashbackTransactions CashbackTransaction[]
  campaignRecipients CampaignRecipient[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([restaurantId, createdAt])
  @@index([email])
  @@index([status])
  @@index([active])
}

model Category {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId  String     @db.ObjectId
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  description   String?
  image         String?
  active        Boolean    @default(true)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  products      Product[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([active])
  @@index([restaurantId, createdAt])
  @@index([sortOrder])
}

model Product {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId      String     @db.ObjectId
  categoryId        String     @db.ObjectId
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category          Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name              String
  slug              String
  description       String?
  image             String?
  price             Float
  promotionalPrice  Float?
  active            Boolean    @default(true)
  featured          Boolean    @default(false)
  preparationTime   Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  orderItems        OrderItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([active])
  @@index([featured])
  @@index([restaurantId, createdAt])
}

model Table {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String     @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  number       Int
  capacity     Int        @default(4)
  qrCode       String
  active       Boolean    @default(true)
  orders       Order[]
  reservations Reservation[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([active])
}

model Order {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId   String       @db.ObjectId
  tableId        String       @db.ObjectId
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table          Table        @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customerName   String
  customerPhone  String
  status         OrderStatus  @default(PENDING)
  total          Float
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  orderItems     OrderItem[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, createdAt])
}

model OrderItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String   @db.ObjectId
  productId   String   @db.ObjectId
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  price       Float
  subtotal    Float

  @@index([orderId])
  @@index([productId])
}

model Reservation {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId      String             @db.ObjectId
  tableId           String             @db.ObjectId
  customerId        String?            @db.ObjectId
  createdByUserId    String?            @db.ObjectId
  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table             Table              @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdByUser     User?              @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  customerName      String
  customerPhone     String
  customerEmail     String?
  guests            Int
  reservationDate   String
  reservationTime   String
  duration          Int
  status            ReservationStatus  @default(PENDING)
  notes             String?
  confirmationCode  String
  source            ReservationSource  @default(WEBSITE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  history           ReservationHistory[]

  @@unique([restaurantId, confirmationCode])
  @@index([restaurantId])
  @@index([restaurantId, tableId])
  @@index([restaurantId, reservationDate])
  @@index([restaurantId, status])
}

model ReservationHistory {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  reservationId  String                @db.ObjectId
  restaurantId   String                @db.ObjectId
  actorUserId    String?               @db.ObjectId
  reservation    Reservation           @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  restaurant     Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  actorUser      User?                 @relation("ReservationHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action         ReservationHistoryAction
  notes          String?
  metadata       Json?
  createdAt      DateTime              @default(now())

  @@index([reservationId])
  @@index([restaurantId])
  @@index([action])
  @@index([restaurantId, createdAt])
}

model CustomerProfile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId    String   @db.ObjectId
  customerId      String   @unique @db.ObjectId
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  notes           String?
  occupation      String?
  preferredLanguage String?
  marketingConsent Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([restaurantId])
}

model CustomerAddress {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId   String   @db.ObjectId
  customerId     String   @db.ObjectId
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String
  street         String?
  number         String?
  neighborhood   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  complement     String?
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([restaurantId])
  @@index([customerId])
}

model CustomerPreferences {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId       String   @db.ObjectId
  customerId         String   @unique @db.ObjectId
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  favoriteCategories Json?
  favoriteProducts   Json?
  dietaryRestrictions Json?
  channels           Json?
  whatsappOptIn      Boolean  @default(false)
  emailOptIn         Boolean  @default(false)
  smsOptIn           Boolean  @default(false)
  pushOptIn          Boolean  @default(false)
  birthdayOptIn      Boolean  @default(false)
  marketingOptIn     Boolean  @default(false)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@index([restaurantId])
}

model CustomerSegment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId   String   @db.ObjectId
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String
  type           CustomerSegmentType
  description    String?
  color          String?
  rule           Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  coupons        Coupon[]

  @@index([restaurantId])
  @@index([type])
}

model LoyaltyAccount {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId       String   @db.ObjectId
  customerId         String   @unique @db.ObjectId
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pointsBalance      Int      @default(0)
  totalPointsEarned  Int      @default(0)
  totalPointsRedeemed Int      @default(0)
  pointsExpiryDays   Int?
  rewardTier         String?
  active             Boolean  @default(true)
  transactions       LoyaltyTransaction[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([restaurantId])
}

model LoyaltyTransaction {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  loyaltyAccountId String   @db.ObjectId
  restaurantId     String   @db.ObjectId
  customerId       String   @db.ObjectId
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type             LoyaltyTransactionType
  points           Int
  orderId          String?  @db.ObjectId
  reservationId    String?  @db.ObjectId
  notes            String?
  metadata         Json?
  expiresAt        DateTime?
  createdAt        DateTime @default(now())

  @@index([loyaltyAccountId])
  @@index([restaurantId])
  @@index([customerId])
}

model Coupon {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId        String   @db.ObjectId
  segmentId           String?  @db.ObjectId
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  segment             CustomerSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  code                String
  name                String
  type                CouponType
  value               Float
  minimumOrderAmount  Float?
  maxUses             Int?
  maxUsesPerCustomer  Int?
  usedCount           Int      @default(0)
  startsAt            DateTime?
  endsAt              DateTime?
  stackable           Boolean  @default(false)
  active              Boolean  @default(true)
  usages              CouponUsage[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@index([type])
  @@index([active])
}

model CouponUsage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  couponId        String   @db.ObjectId
  restaurantId    String   @db.ObjectId
  customerId      String?  @db.ObjectId
  orderId         String?  @db.ObjectId
  reservationId   String?  @db.ObjectId
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  usedAt          DateTime @default(now())
  discountAmount  Float
  metadata        Json?

  @@index([couponId])
  @@index([restaurantId])
  @@index([customerId])
}

model CashbackAccount {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId    String   @db.ObjectId
  customerId      String   @unique @db.ObjectId
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  balance         Float    @default(0)
  totalEarned     Float    @default(0)
  totalRedeemed   Float    @default(0)
  expiresAt       DateTime?
  active          Boolean  @default(true)
  transactions    CashbackTransaction[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([restaurantId])
}

model CashbackTransaction {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  cashbackAccountId String   @db.ObjectId
  restaurantId     String   @db.ObjectId
  customerId       String   @db.ObjectId
  cashbackAccount  CashbackAccount @relation(fields: [cashbackAccountId], references: [id], onDelete: Cascade)
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type             CashbackTransactionType
  amount           Float
  orderId          String?  @db.ObjectId
  reservationId    String?  @db.ObjectId
  notes            String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([cashbackAccountId])
  @@index([restaurantId])
  @@index([customerId])
}

model Campaign {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId   String   @db.ObjectId
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String
  channel        CampaignChannel
  status         CampaignStatus @default(DRAFT)
  subject        String?
  message        String?
  audience       Json?
  scheduledAt    DateTime?
  sentAt         DateTime?
  totalRecipients Int      @default(0)
  totalDelivered  Int      @default(0)
  active         Boolean  @default(true)
  recipients     CampaignRecipient[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([restaurantId])
  @@index([channel])
  @@index([status])
}

model CampaignRecipient {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId     String   @db.ObjectId
  restaurantId   String   @db.ObjectId
  customerId     String   @db.ObjectId
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status         CampaignRecipientStatus @default(PENDING)
  deliveredAt    DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([campaignId])
  @@index([restaurantId])
  @@index([customerId])
}

